# ===== 模型通道（都不填则自动进入本地演示库模式）=====
# 通用 OpenAI 兼容通道（推荐）：DeepSeek / 智谱 / 通义 / OpenAI / 自建网关
# DeepSeek 示例：https://api.deepseek.com/v1  +  deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 主通道：魔搭 ModelScope（OpenAI 兼容）
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=Qwen/Qwen2.5-72B-Instruct

# 备用通道：商汤日日新（二选一）
# 方式一：控制台签发的单个 API Key
SENSENOVA_API_KEY=
# 方式二：AK/SK 换 JWT（Access Key ID + Secret Access Key）
SENSENOVA_AK=
SENSENOVA_SK=
SENSENOVA_MODEL=SenseChat-5

# ===== 安全 =====
# 会话签名密钥，生产环境务必替换为随机 32+ 位字符串
JWT_SECRET=change-me-to-a-random-secret
# 注册为该用户名时自动获得管理员权限
ADMIN_USERNAME=
# PBKDF2 迭代次数（免费实例可降至 20000）
PBKDF2_ITERATIONS=100000

# ===== Cloudflare Turnstile（不填则跳过人机验证）=====
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ===== 服务 =====
PORT=0
NODE_ENV=development
